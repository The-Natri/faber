{
  "name": "natris-faber",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder build --win --publish never",
    "postinstall": "electron-builder install-app-deps",
    "dev:refresh-db": "node scripts/refresh-dev-db.mjs",
    "ship": "node scripts/ship.mjs",
    "ship:beta": "node scripts/ship.mjs --beta",
    "lint": "eslint .",
    "test": "node scripts/run-vitest.mjs"
  },
  "build": {
    "appId": "com.natri.faber",
    "productName": "Natri's Faber",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "rebuild": {
    "buildFromSource": true,
    "modules": [
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toast": "^1.2.24",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@radix-ui/react-visually-hidden": "^1.2.12",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.13.2",
    "better-sqlite3": "12.11.1",
    "dotenv": "^16.4.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "playwright": "^1.49.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron@42.5.0": true
  }
}
